# Runtime Environment Configuration
NODE_ENV=development
LOG_LEVEL=info

# OpenAI API Authentication
# Required for tool calling and structured outputs
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Langfuse Observability & Telemetry Configuration
# Sign up at https://cloud.langfuse.com or deploy a self-hosted instance
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# Langfuse API Host:
# EU Region Default: https://cloud.langfuse.com
# US Region Default: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com